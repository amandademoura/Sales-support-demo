# Only needed if the shared api.cognee.ai gateway is down -- point directly
# at your tenant's own URL instead (find it in the Cognee Cloud dashboard,
# or in a raw search response's "dataset_tenant_id" field)
COGWIT_API_BASE=https://tenant-<your-tenant-id>.aws.cognee.ai
OPENAI_API_KEY=sk-...
COGNEE_API_KEY=...
ENABLE_BACKEND_ACCESS_CONTROL=false
